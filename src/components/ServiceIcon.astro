---
import { icons } from "../lib/icons";

interface Props {
  name: string;
}

const { name } = Astro.props;
const svg = icons[name] ?? "";
---

<span class="service-icon" aria-hidden="true" set:html={svg} />

<style>
  .service-icon {
    display: inline-flex;
    color: var(--color-accent);
  }

  .service-icon :global(svg) {
    width: 24px;
    height: 24px;
  }
</style>
