---
import type { Service, ServiceStatus } from "../config/validate";
import ServiceIcon from "./ServiceIcon.astro";

interface Props {
  service: Service;
}

const { service } = Astro.props;

// Live/beta services render as link cards; planned services render as
// non-interactive div cards.
const isLink = service.url !== "";
const CardTag = isLink ? "a" : "div";
const linkAttrs = isLink ? { href: service.url } : {};

const statusLabels: Record<ServiceStatus, string> = {
  live: "Live",
  beta: "Beta",
  planned: "Planned",
};
---

<CardTag class:list={["card", { "card-link": isLink }]} {...linkAttrs}>
  <div class="card-head">
    <ServiceIcon name={service.icon} />
    <span class:list={["badge", `badge-${service.status}`]}>
      {statusLabels[service.status]}
    </span>
  </div>
  <h3 class="card-title">{service.name}</h3>
  <p class="card-desc">{service.description}</p>
</CardTag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .card-link:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border-accent);
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .card-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .card-desc {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-status-planned);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .badge::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: currentColor;
  }

  .badge-live {
    color: var(--color-status-live);
    border-color: rgba(74, 222, 128, 0.35);
  }

  .badge-beta {
    color: var(--color-status-beta);
    border-color: rgba(224, 164, 88, 0.4);
  }

  .badge-planned {
    color: var(--color-status-planned);
  }
</style>
